---
import type {
    DisplaySettingsFragment,
    OwensCorningNewsItemFragment,
} from '../../../../__generated/sdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import { getDictionaryFromDisplaySettings } from '../../../graphql/shared/displaySettingsHelpers';
import { isEditContext, getLink } from '../../shared/utils.ts';
import type { ButtonLinkData } from '../../shared/utils.ts';

const isCmsEdit = isEditContext(Astro.url);
const currentDomain = Astro.url.origin;

export interface Props {
    key: string;
    data: OwensCorningNewsItemFragment;
    displaySettings: DisplaySettingsFragment[];
    displayTemplateKey: string;
    contentPayload: ContentPayload;
}
const { key, data, displaySettings } = Astro.props as Props;

const dictionary = getDictionaryFromDisplaySettings(displaySettings);
const openInNewTab =
    dictionary['openInNewTab'] === 'true' ||
    (data.Link as any)?.target === '_blank';

const linkHref = data.Link
    ? getLink(data.Link as ButtonLinkData, currentDomain)
    : null;
const linkText = (data.Link as any)?.text || 'Learn More';

const componentClass = 'component-oc-news-item';
---

<article
    class:list={[
        'flex h-full flex-col border border-[#dddddd] bg-white p-6',
        componentClass,
    ]}
    data-epi-block-id={(isCmsEdit && key) || undefined}
>
    {
        data.Prehead && (
            <p class="mb-2 text-xs font-bold uppercase tracking-widest text-[#c1241a]">
                {data.Prehead}
            </p>
        )
    }
    {
        data.Title && (
            <h3 class="mb-3 font-['Oswald',sans-serif] text-base font-semibold uppercase leading-tight text-[#333333]">
                {data.Title}
            </h3>
        )
    }
    {
        data.Body?.html && (
            <div
                class="mb-5 flex-1 text-sm leading-[1.6] text-[#666666]"
                set:html={data.Body.html}
            />
        )
    }
    {
        linkHref && (
            <a
                class="inline-flex w-fit items-center gap-1.5 border-2 border-[#c1241a] bg-[#c1241a] px-5 py-2.5 text-[0.8125rem] font-bold uppercase tracking-wider text-white transition-colors hover:bg-transparent hover:text-[#c1241a]"
                href={linkHref}
                target={openInNewTab ? '_blank' : undefined}
                rel={openInNewTab ? 'noopener noreferrer' : undefined}
            >
                {linkText}
                <span aria-hidden="true">&rsaquo;</span>
            </a>
        )
    }
</article>
