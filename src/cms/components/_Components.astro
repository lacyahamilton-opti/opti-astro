---
import type { ContentPayload } from '../../graphql/shared/ContentPayload';
import ArticlePageCard from '../pages/ArticlePage/ArticlePageCard.astro';
import ArticleList from './ArticleListComponent/ArticleList.astro';
import Button from './ButtonComponent/Button.astro';
import DamAssetList from './DamAssetListComponent/DamAssetList.astro';
import CallToAction from './CallToActionComponent/CallToAction.astro';
import Card from './CardComponent/Card.astro';
import Carousel from './CarouselComponent/Carousel.astro';
import Collapse from './CollapseComponent/Collapse.astro';
import Divider from './DividerComponent/Divider.astro';
import FacetedSearch from './FacetedSearchComponent/FacetedSearch.astro';
import Grid from './GridComponent/Grid.astro';
import Hero from './HeroComponent/Hero.astro';
import Iframe from './IframeComponent/Iframe.astro';
import Image from './ImageComponent/Image.astro';
import OdpForm from './OdpFormComponent/OdpForm.astro';
import Paragraph from './ParagraphComponent/Paragraph.astro';
import Text from './TextComponent/Text.astro';
import Video from './VideoComponent/Video.astro';
import VideoExternal from './VideoExternalComponent/VideoExternal.astro';
import OptiForm from '../forms/base/OptiFormsContainerDataComponent/OptiForm.astro';
import OwensCorningHero from './OwensCorningHeroComponent/OwensCorningHero.astro';
import OwensCorningCard from './OwensCorningCardComponent/OwensCorningCard.astro';
import OwensCorningCardSet from './OwensCorningCardSetComponent/OwensCorningCardSet.astro';
import OwensCorningQuickLink from './OwensCorningQuickLinkComponent/OwensCorningQuickLink.astro';
import OwensCorningQuickLinks from './OwensCorningQuickLinksComponent/OwensCorningQuickLinks.astro';
import OwensCorningAttentionBar from './OwensCorningAttentionBarComponent/OwensCorningAttentionBar.astro';
import OwensCorningNewsItem from './OwensCorningNewsItemComponent/OwensCorningNewsItem.astro';
import OwensCorningNewsSection from './OwensCorningNewsSectionComponent/OwensCorningNewsSection.astro';
import OwensCorningFooterColumn from './OwensCorningFooterColumnComponent/OwensCorningFooterColumn.astro';
import OwensCorningSocialLink from './OwensCorningSocialLinkComponent/OwensCorningSocialLink.astro';
import OwensCorningFooter from './OwensCorningFooterComponent/OwensCorningFooter.astro';

interface Props {
    contentPayload: ContentPayload;
    data: any;
}

const { contentPayload, data } = Astro.props as Props;
const { component, displaySettings, displayTemplateKey } = data;
const componentType = component._metadata.types[0];
---

{
    componentType === 'Text' && (
        <Text
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'CallToAction' && (
        <CallToAction
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displayTemplateKey={displayTemplateKey}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Image' && (
        <Image
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Video' && (
        <Video
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Paragraph' && (
        <Paragraph
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Card' && (
        <Card
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}
{
    componentType === 'Hero' && (
        <Hero
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Carousel' && (
        <Carousel
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}
{
    componentType === 'Collapse' && (
        <Collapse
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'ArticleList' && (
        <ArticleList
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Grid' && (
        <Grid
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}
{
    componentType === 'Button' && (
        <Button
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}

{
    componentType === 'Iframe' && (
        <Iframe
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}
{
    componentType === 'VideoExternal' && (
        <VideoExternal
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}

{
    componentType === 'ArticlePage' && (
        <ArticlePageCard
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
        />
    )
}

{
    componentType === 'Divider' && (
